# Public, non-secret build metadata only. Do not add API keys or credentials here.
VITE_APP_NAME=Hotech Globe Tracker

# Server-only. Never prefix with VITE_ and never commit real values.
# Email of the Admin row in the Users sheet that the password login signs in as.
ADMIN_EMAIL=
# Optional. Subject bound to that Users row (default: password:ryanzkey). If the
# row's provider_subject is already set (e.g. from an old Google login), either
# clear that cell or put its current value here.
ADMIN_PROVIDER_SUBJECT=
APPS_SCRIPT_INTERNAL_URL=
APPS_SCRIPT_CRUD_URL=
INTERNAL_AUDIENCE=
INTERNAL_HMAC_KEYS_JSON=
INTERNAL_HMAC_ACTIVE_KEY_ID=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_KEY_SECRET=
